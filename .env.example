# OpenRouter (required)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional model override (GitHub Actions variable: TORII_MODEL)
# Script default (F26): anthropic/claude-opus-5 — paid; leave unset to use it.
# TORII_MODEL=anthropic/claude-opus-5
# Cheaper smoke / cost-sensitive targets:
# TORII_MODEL=openai/gpt-5-mini

# Optional Hermes pin (GitHub Actions variable: TORII_HERMES_COMMIT)
# Default: known-good SHA in scripts/hermes-pin.sh. Use latest|main to float.
# TORII_HERMES_COMMIT=53559aaf86b84dadae83cd9bb605ca476f9a0606

# Hub memory (target → Mr-Ashish/torii-gate)
# TORII_HUB_TOKEN=ghp_...
# TORII_HUB_REPO=Mr-Ashish/torii-gate
# TORII_HUB_PUBLISH=1

# Local helpers
# REPO=owner/repo
# PR_NUMBER=123
# POST_COMMENT=0
# MAX_DIFF_BYTES=400000

# Optional re-trigger cooldown seconds (GitHub var: TORII_COOLDOWN_SECONDS; 0=off)
# TORII_COOLDOWN_SECONDS=900

# F29 soft max OpenRouter spend USD (GitHub var: TORII_MAX_COST_USD; 0/off=disabled)
# TORII_MAX_COST_USD=1.00

# F36 hermes wall-clock timeout seconds (GitHub var: TORII_REVIEW_TIMEOUT_SECONDS)
# Default 1500 when unset. 0/off disables. Kills hung agent loops (exit 124).
# TORII_REVIEW_TIMEOUT_SECONDS=1500

# F41 Hermes max tool-calling turns (GitHub var: TORII_MAX_TURNS)
# Default 40 when unset. 0/off = Hermes unlimited (~500). Caps OpenRouter thrash.
# TORII_MAX_TURNS=40

# F37 verdict PR labels (GitHub var: TORII_PR_LABELS; 0=off)
# TORII_PR_LABELS=1
# TORII_LABEL_PREFIX=torii

# F38 path-glob free skip (GitHub var: TORII_SKIP_PATH_GLOBS; empty=off)
# Preset: docs  |  custom: *.md,docs/**,CHANGELOG*
# TORII_SKIP_PATH_GLOBS=docs

# F9c GitHub apply-suggestion blocks (from ### Code suggestions)
# TORII_INLINE_SUGGESTIONS=1
# TORII_SUGGESTION_MAX=3

# F53 linked issue context (Fixes/#N → issue title/body/comments in prompt)
# TORII_ISSUE_CONTEXT=1
# TORII_ISSUE_CONTEXT_MAX=3
# TORII_ISSUE_FROM_BRANCH=1




# Optional prebaked runner image (GitHub var: TORII_RUNNER_IMAGE)
# TORII_RUNNER_IMAGE=ghcr.io/mr-ashish/torii-hermes-runner:53559aaf86b8

# F22: post commit status on PR head (GitHub var TORII_COMMIT_STATUS; 0=off)
# TORII_COMMIT_STATUS=1
# TORII_STATUS_CONTEXT=torii/review
# Product merge gate context is always posted as torii/gate (via torii_gate_status.py).
# TORII_GATE_STRICT=0   # GitHub var: 1 = fail the job when gate block=true

# F55 unified toggles (optional file overrides; env still wins)
# JSON map of short keys or TORII_* names — see docs/examples/toggles.json.example
# TORII_TOGGLES_FILE=.torii/toggles.json
# TORII_FIXIT_PROMPTS=1

# F56 named multi-lens recipe packs (agent/packs/*.json)
# TORII_LENS_PACKS=1
# TORII_LENS_PACK=default   # security | docs | odoo | performance
# TORII_LENS_PACKS_DIR=     # optional override directory

# F57 Mermaid architecture diagram from changed files (assemble + soft review inject)
# TORII_MERMAID=1
# TORII_MERMAID_MAX_NODES=24
# TORII_MERMAID_MAX_FILES_PER_GROUP=6

# F58 deterministic PR description scaffold (assemble writes pr-description.md)
# TORII_PR_DESCRIPTION=1
# TORII_PR_DESCRIPTION_APPLY=0   # set 1 to allow gh pr edit via apply CLI
# TORII_PR_DESCRIPTION_MODE=fill-empty  # fill-empty | markers | force

# F59 incremental review (default off — scopes diff to commits since last Torii head= marker)
# TORII_INCREMENTAL=1
# TORII_INCREMENTAL_FIXTURE=  # hermetic tests

# F60 reply on existing Torii inline threads (default on; re-review uses in_reply_to)
# TORII_REPLY_ON_THREAD=1
# TORII_REPLY_MATCH=path_line
# TORII_REPLY_MAX=6

